# Copy this file to .env and fill in real values. .env itself is gitignored.

# Optional. If unset, the app falls back to a local SQLite file (finance.db).
# Set this to a Postgres URL for local dev with Postgres.
DATABASE_URL=postgresql://user@localhost/finance_app_dev

# Required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Email (welcome + 7-day check-in) ---
# Get a free API key at https://resend.com — no domain verification needed
# to start, since onboarding@resend.dev works out of the box.
RESEND_API_KEY=
EMAIL_FROM=Anchorpoint <onboarding@resend.dev>

# Base URL used in email links/footers. Set this to your real deployed URL
# in production (e.g. https://yourname.pythonanywhere.com).
APP_URL=http://localhost:5000
